{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "PRUNIQ",
    "version":  "0.1.0",
    "identifier":  "org.adt.android-debloating-toolkit",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "PRUNIQ — Android Debloating Toolkit",
                                    "width":  1240,
                                    "height":  780,
                                    "minWidth":  920,
                                    "minHeight":  620
                                }
                            ],
                "security":  {
                                 "csp":  "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/icon.ico"
                            ],
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "category":  "Utility",
                   "copyright":  "Copyright © 2026 Syed Shaheer Ali",
                   "license":  "Apache-2.0",
                   "shortDescription":  "Local-first Android package management desktop utility using external ADB",
                   "longDescription":  "PRUNIQ (Android Debloating Toolkit) is an offline-first Windows desktop utility for inspecting connected Android devices, scanning installed packages, reviewing conservative evidence-based recommendations, and performing reversible package management with local SQLite recovery snapshots."
               }
}
